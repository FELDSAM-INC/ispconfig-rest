#!/usr/bin/env bash
#
# ispconfig-rest — manage the ISPConfig REST API installation.
#
# Installed to /usr/local/bin/ispconfig-rest by install.sh. Reads
# /etc/ispconfig-rest/install.conf to locate the deployment.
#
#   ispconfig-rest update                 update current branch; keep release tags pinned
#   ispconfig-rest update --branch main   switch to the stable branch and update
#   ispconfig-rest update --tag v1.0.1    install a specific release (detached HEAD)
#   ispconfig-rest status                 service state, version, DB connectivity
#   ispconfig-rest restart|start|stop     control the service
#   ispconfig-rest logs [-f]              service logs
#   ispconfig-rest key:create NAME [--client-id N]   mint an API key
#   ispconfig-rest key:list [--client-id N]     list API keys (never shows secrets)
#   ispconfig-rest key:revoke ID                  revoke (deactivate) an API key
#   ispconfig-rest firewall:allow PORT [--proto tcp]  open a port in the ISPConfig firewall
#   ispconfig-rest server-tools install|update|status [OPTIONS]  workers + WAF on ISPConfig servers
#   ispconfig-rest server-tools install --help      SSH, server selection and component options
#   ispconfig-rest artisan ...            run an artisan command as the run user
#   ispconfig-rest version                installed version + commit
#   ispconfig-rest uninstall              remove service + manager (keeps DB data)

set -euo pipefail
# release-aware-updater-v1: keep this manager when selecting older API releases.

STATE_FILE="/etc/ispconfig-rest/install.conf"

if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_B=$'\033[1m'; C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_C=$'\033[36m'
else C_RESET="" C_B="" C_G="" C_Y="" C_R="" C_C=""; fi
info(){ printf '%s\n' "${C_C}▸${C_RESET} $*"; }
ok(){   printf '%s\n' "${C_G}✓${C_RESET} $*"; }
warn(){ printf '%s\n' "${C_Y}!${C_RESET} $*" >&2; }
die(){  printf '%s\n' "${C_R}✗${C_RESET} $*" >&2; exit 1; }

[ -f "$STATE_FILE" ] || die "Not installed: $STATE_FILE missing. Run install.sh first."
# shellcheck disable=SC1090
. "$STATE_FILE"
: "${INSTALL_DIR:?}" "${RUN_USER:?}" "${SERVICE_NAME:=ispconfig-rest}" "${PHP_BIN:=php}"

need_root(){ [ "$(id -u)" = "0" ] || die "This command must run as root (use sudo)."; }
run_as(){ sudo -u "$RUN_USER" env -C "$INSTALL_DIR" "$@"; }

cmd_server_tools() {
  need_root
  command -v python3 >/dev/null || die "Install Python 3.8+ on this REST host first."
  local helper=/usr/local/lib/ispconfig-rest-cli/manage.py
  # Older manager versions refresh only this script during update. Bootstrap
  # the new helpers from the same published commit without running API code as root.
  { [ -f "$helper" ] && [ -f /usr/local/lib/ispconfig-rest-cli/remote.php ]; } || install_server_tools_manager
  shift
  ISPCP_TOOLS_INSTALL_DIR="$INSTALL_DIR" ISPCP_TOOLS_RUN_USER="$RUN_USER" ISPCP_TOOLS_PHP="$PHP_BIN" ISPCP_TOOLS_BRANCH="${RELEASE_REF:-${BRANCH:-main}}" \
    python3 "$helper" "$@"
}

install_server_tools_manager() {
  local revision stage refresh_manager="${1:-}"
  revision="$(run_as git rev-parse HEAD)"
  [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || die "Cannot determine installed release."
  stage="$(mktemp -d /root/ispconfig-rest-cli.XXXXXXXX)"
  if ! (
    trap 'rm -rf -- "$stage"' EXIT
    git init --bare "$stage/repository" >/dev/null 2>&1 || exit 1
    git -c core.hooksPath=/dev/null -c protocol.file.allow=never -C "$stage/repository" fetch --no-tags https://github.com/FELDSAM-INC/ispconfig-rest.git "${RELEASE_REF:-${BRANCH:-main}}" || exit 1
    # The checkout's revision is untrusted input. It must belong to the ref
    # selected in root-owned install.conf, not merely an arbitrary public object.
    git -C "$stage/repository" merge-base --is-ancestor "$revision" FETCH_HEAD || exit 1
    for file in manage.py remote.php; do
      git -C "$stage/repository" show "$revision:server-tools/$file" > "$stage/$file" || exit 1
    done
    install -d -o root -g root -m 0755 /usr/local/lib/ispconfig-rest-cli || exit 1
    install -o root -g root -m 0644 "$stage/manage.py" "$stage/remote.php" /usr/local/lib/ispconfig-rest-cli/ || exit 1
    if [ "$refresh_manager" = --refresh-manager ]; then
      # Never install root-executed code directly from the web-owned checkout.
      git -C "$stage/repository" show "$revision:bin/ispconfig-rest" > "$stage/manager" || exit 1
      if grep -q '^# release-aware-updater-v1:' "$stage/manager"; then
        install -o root -g root -m 0755 "$stage/manager" /usr/local/bin/ispconfig-rest || exit 1
      else
        info "Keeping the current manager: this API release predates branch/tag-aware updates."
      fi
    fi
  ); then die "Could not install trusted server-tools helpers for $revision."; fi
}

# API timezone alignment (spec 017 FR-015): ISPConfig writes traffic dates in
# the server's local time, so APP_TIMEZONE follows the system timezone unless
# it was chosen explicitly at install time (TIMEZONE_MODE="explicit").
detect_system_timezone(){
  local tz=""
  if command -v timedatectl >/dev/null 2>&1; then tz="$(timedatectl show -p Timezone --value 2>/dev/null || true)"; fi
  if [ -z "$tz" ] && [ -r /etc/timezone ]; then tz="$(tr -d '[:space:]' < /etc/timezone || true)"; fi
  if [ -z "$tz" ] && [ -L /etc/localtime ]; then tz="$(readlink -f /etc/localtime || true)"; tz="${tz#/usr/share/zoneinfo/}"; fi
  printf '%s' "$tz"
}
valid_timezone(){
  [ -n "$1" ] && ISPC_REST_TZ="$1" "$PHP_BIN" -r 'exit(in_array(getenv("ISPC_REST_TZ"), timezone_identifiers_list(), true) ? 0 : 1);'
}
env_timezone(){
  { sed -n 's/^APP_TIMEZONE=//p' "$INSTALL_DIR/.env" 2>/dev/null || true; } | tail -n 1 | tr -d "\"'"
}
set_state(){
  if grep -q "^$1=" "$STATE_FILE"; then sed -i "s|^$1=.*|$1=\"$2\"|" "$STATE_FILE"; else printf '%s="%s"\n' "$1" "$2" >> "$STATE_FILE"; fi
}
sync_timezone(){
  if [ "${TIMEZONE_MODE:-auto}" = "explicit" ]; then info "Timezone: $(env_timezone) (explicit, left unchanged)"; return 0; fi
  local detected current
  detected="$(detect_system_timezone)"
  current="$(env_timezone)"
  if ! valid_timezone "$detected"; then warn "Could not detect a valid system timezone — APP_TIMEZONE left as ${current:-unset}."; return 0; fi
  if [ "$detected" != "$current" ]; then
    if grep -q '^APP_TIMEZONE=' "$INSTALL_DIR/.env"; then
      sed -i "s|^APP_TIMEZONE=.*|APP_TIMEZONE=$detected|" "$INSTALL_DIR/.env"
    else
      printf 'APP_TIMEZONE=%s\n' "$detected" >> "$INSTALL_DIR/.env"
    fi
    chown "$RUN_USER":"$RUN_USER" "$INSTALL_DIR/.env"; chmod 600 "$INSTALL_DIR/.env"
    ok "Timezone set to $detected"
  fi
  set_state TIMEZONE "$detected"
  set_state TIMEZONE_MODE auto
}

# Reload the php-fpm pool (recycles workers → new code) and the web server.
reload_server(){
  [ -n "${FPM_SERVICE:-}" ] && [ "${SERVE_BACKEND:-}" = "fpm" ] && \
    { systemctl reload "$FPM_SERVICE" 2>/dev/null || systemctl restart "$FPM_SERVICE"; ok "php-fpm ($FPM_SERVICE) reloaded"; }
  case "${SERVE_MODE:-}" in
    apache) apache2ctl configtest 2>/dev/null && { systemctl reload apache2 2>/dev/null || systemctl restart apache2; ok "apache reloaded"; } || warn "apache configtest failed";;
    nginx)  nginx -t 2>/dev/null && { systemctl reload nginx; ok "nginx reloaded"; } || warn "nginx configtest failed";;
    *) info "Serve mode '${SERVE_MODE:-none}' — reload your web front end manually.";;
  esac
}

cmd_version() {
  local ver commit branch tag location
  ver="$(cat "$INSTALL_DIR/VERSION" 2>/dev/null || echo '?')"
  commit="$(run_as git rev-parse --short HEAD 2>/dev/null || echo '?')"
  branch="$(run_as git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  tag="$(run_as git describe --tags --exact-match --match 'v[0-9]*' HEAD 2>/dev/null || true)"
  if [ -n "$branch" ]; then location="on branch $branch"
  elif [ -n "$tag" ]; then location="at release $tag (detached, pinned)"
  else location="at detached commit $commit"; fi
  echo "ISPConfig REST API $ver ($commit) $location"
}

cmd_status() {
  cmd_version
  echo
  local env_tz sys_tz
  env_tz="$(env_timezone)"
  sys_tz="$(detect_system_timezone)"
  if [ -n "$env_tz" ] && [ "$env_tz" = "$sys_tz" ]; then
    ok "timezone: $env_tz (system: $sys_tz, mode: ${TIMEZONE_MODE:-auto})"
  else
    warn "timezone: ${env_tz:-unset} (system: ${sys_tz:-unknown}, mode: ${TIMEZONE_MODE:-auto}) — differs from the system timezone"
  fi
  if [ "${SERVE_BACKEND:-}" = "fpm" ] && [ -n "${FPM_SERVICE:-}" ]; then
    systemctl is-active --quiet "$FPM_SERVICE" && ok "php-fpm: active ($FPM_SERVICE, pool $SERVICE_NAME)" || warn "php-fpm: inactive"
  fi
  case "${SERVE_MODE:-}" in
    apache) systemctl is-active --quiet apache2 && ok "apache: active (vhost :${PUBLIC_PORT:-?}, ${SERVE_BACKEND:-?})" || warn "apache: inactive";;
    nginx)  systemctl is-active --quiet nginx && ok "nginx: active (vhost :${PUBLIC_PORT:-?})" || warn "nginx: inactive";;
    *) info "serve mode: ${SERVE_MODE:-none} (unmanaged)";;
  esac
  if run_as "$PHP_BIN" -r '
    require "vendor/autoload.php"; $a=require "bootstrap/app.php";
    $a->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
    Illuminate\Support\Facades\DB::select("select 1"); echo "";' >/dev/null 2>&1; then
    ok "database: reachable"
  else
    warn "database: NOT reachable — check .env credentials"
  fi
}

cmd_schedule_install() {
  need_root
  install -d -m 0755 /etc/cron.d
  cat > /etc/cron.d/ispconfig-rest <<'CRON'
# API-owned background work: run as the installation's unprivileged service user.
* * * * * root /usr/local/bin/ispconfig-rest schedule:run >/dev/null 2>&1
CRON
  chmod 0644 /etc/cron.d/ispconfig-rest
  ok "One-minute API scheduler installed"
}

valid_update_branch() {
  [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_./-]*$ ]] && git check-ref-format "refs/heads/$1" >/dev/null
}
valid_release_tag() {
  [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] && git check-ref-format "refs/tags/$1" >/dev/null
}

update_checkout() {
  local branch="" tag="" selected="" target
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch|--tag)
        [ $# -ge 2 ] && [ -n "$2" ] || die "$1 requires a value."
        [ -z "$selected" ] || die "Choose either --branch NAME or --tag VERSION."
        selected="$1"
        if [ "$1" = --branch ]; then branch="$2"; else tag="$2"; fi
        shift 2;;
      *) die "Unknown update option: $1 (try 'ispconfig-rest update --help').";;
    esac
  done
  if [ -z "$selected" ]; then branch="$(run_as git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"; fi
  [ -z "$branch" ] || valid_update_branch "$branch" || die "Invalid update branch."
  [ -z "$tag" ] || valid_release_tag "$tag" || die "Expected a release tag such as v1.0.1."
  run_as git diff --quiet && run_as git diff --cached --quiet \
    || die "Tracked files have local changes. Commit or save them before updating."

  # Explicit refspecs also work with single-branch shallow installer clones.
  # Do not force-fetch tags: a moved release must fail instead of silently changing.
  if [ -n "$branch" ]; then
    info "Update channel: branch $branch"
    run_as git fetch --atomic origin "+refs/heads/$branch:refs/remotes/origin/$branch" 'refs/tags/*:refs/tags/*'
    target="refs/remotes/origin/$branch"
    if run_as git show-ref --verify --quiet "refs/heads/$branch"; then
      run_as git merge-base --is-ancestor "refs/heads/$branch" "$target" \
        || die "Branch $branch has diverged from origin. Resolve local commits before updating."
    fi
    run_as git checkout -B "$branch" "$target"
    RELEASE_REF="refs/heads/$branch"
    BRANCH="$branch"
  else
    run_as git fetch --atomic origin 'refs/tags/*:refs/tags/*'
    if [ -z "$tag" ]; then
      tag="$(run_as git describe --tags --exact-match --match 'v[0-9]*' HEAD 2>/dev/null || true)"
      valid_release_tag "$tag" || die "Detached HEAD is not a release tag. Choose 'update --branch main' or 'update --tag VERSION'."
    fi
    target="refs/tags/$tag"
    # The tag must still exist on origin, not only in the local tag cache.
    run_as git ls-remote --exit-code --refs origin "$target" >/dev/null \
      || die "Release $tag was not found on origin."
    info "Update channel: release $tag (pinned; use --branch main to follow stable updates)"
    run_as git checkout --detach "$target"
    RELEASE_REF="$target"
    BRANCH="$tag"
  fi
  # Both values are validated refs with no shell/sed metacharacters. Saved state
  # is used for trusted worker provenance; it never overrides the next checkout.
  set_state BRANCH "$BRANCH"
  set_state RELEASE_REF "$RELEASE_REF"
}

cmd_update() {
  if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    echo "Usage: ispconfig-rest update [--branch NAME | --tag VERSION]"
    echo "Without options: update the current branch, or keep a detached release tag pinned."
    return
  fi
  need_root
  info "Updating ISPConfig REST API in $INSTALL_DIR"
  local before after
  before="$(run_as git rev-parse --short HEAD 2>/dev/null || echo '?')"
  update_checkout "$@"
  after="$(run_as git rev-parse --short HEAD 2>/dev/null || echo '?')"

  if [ "$before" = "$after" ]; then ok "Already up to date ($after)"; else info "Updated $before → $after"; fi

  local composer="composer"; command -v composer >/dev/null 2>&1 || composer="$PHP_BIN $INSTALL_DIR/composer.phar"
  run_as env COMPOSER_HOME="$INSTALL_DIR/.composer" $composer install --no-dev --optimize-autoloader --no-interaction --no-progress
  run_as "$PHP_BIN" artisan migrate --force
  sync_timezone
  run_as "$PHP_BIN" artisan config:cache >/dev/null 2>&1 || true
  run_as "$PHP_BIN" artisan route:cache  >/dev/null 2>&1 || true
  install_server_tools_manager --refresh-manager

  cmd_schedule_install
  reload_server
  ok "Update complete ($(cat "$INSTALL_DIR/VERSION" 2>/dev/null))"
}

cmd_service() { # restart (start/stop don't apply — the web server + fpm are shared)
  need_root
  [ "$1" = "restart" ] && { reload_server; return; }
  die "Use 'restart' to reload the app (php-fpm + web server); start/stop of shared services is out of scope."
}

cmd_logs() {
  # Prefer the app's own Laravel log; fall back to the Apache vhost error log.
  local applog="$INSTALL_DIR/storage/logs/laravel.log"
  local weblog="/var/log/apache2/${SERVICE_NAME}-error.log"
  local log="$applog"; [ -f "$applog" ] || log="$weblog"
  [ -f "$log" ] || die "No log file found ($applog or $weblog)."
  if [ "${1:-}" = "-f" ]; then tail -f "$log"; else tail -n "${1:-50}" "$log"; fi
}

cmd_key_create()    { need_root; shift || true; run_as "$PHP_BIN" artisan api:key:create "$@"; }
cmd_key_list()      { need_root; shift || true; run_as "$PHP_BIN" artisan api:key:list "$@"; }
cmd_key_revoke()    { need_root; shift || true; run_as "$PHP_BIN" artisan api:key:revoke "$@"; }
cmd_firewall_allow(){ need_root; shift || true; run_as "$PHP_BIN" artisan firewall:allow "$@"; }
cmd_artisan()       { need_root; shift || true; run_as "$PHP_BIN" artisan "$@"; }

cmd_uninstall() {
  need_root
  # Web vhost
  case "${SERVE_MODE:-}" in
    apache) a2dissite "$SERVICE_NAME" >/dev/null 2>&1 || true
            rm -f "/etc/apache2/sites-available/${SERVICE_NAME}.conf"
            apache2ctl configtest 2>/dev/null && systemctl reload apache2 2>/dev/null || true
            ok "Removed Apache vhost";;
    nginx)  rm -f "/etc/nginx/sites-enabled/${SERVICE_NAME}.conf" "/etc/nginx/sites-available/${SERVICE_NAME}.conf"
            nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null || true
            ok "Removed nginx vhost";;
  esac
  # php-fpm pool
  if [ "${SERVE_BACKEND:-}" = "fpm" ] && [ -n "${FPM_SERVICE:-}" ]; then
    local pooldir
    for pooldir in /etc/php/*/fpm/pool.d /etc/php-fpm.d; do rm -f "$pooldir/${SERVICE_NAME}.conf" 2>/dev/null || true; done
    systemctl reload "$FPM_SERVICE" 2>/dev/null || true
    ok "Removed php-fpm pool"
  fi
  rm -f /usr/local/bin/ispconfig-rest
  rm -f /usr/local/lib/ispconfig-rest-cli/manage.py /usr/local/lib/ispconfig-rest-cli/remote.php
  ok "Removed manager. Left in place: $INSTALL_DIR, $STATE_FILE, and the API-owned"
  ok "DB tables (api_keys, migrations)."
  echo "  To fully remove:  rm -rf $INSTALL_DIR /etc/ispconfig-rest"
  echo "  and, if desired:  DROP TABLE api_keys, migrations;   (in the ISPConfig database)"
}

case "${1:-}" in
  update)        shift; cmd_update "$@";;
  schedule:install) cmd_schedule_install;;
  schedule:run)   run_as "$PHP_BIN" artisan schedule:run;;
  status)        cmd_status;;
  version|-v|--version) cmd_version;;
  start|stop|restart)   cmd_service "$1";;
  logs)          shift; cmd_logs "$@";;
  key:create)    cmd_key_create "$@";;
  key:list)      cmd_key_list "$@";;
  key:revoke)    cmd_key_revoke "$@";;
  firewall:allow) cmd_firewall_allow "$@";;
  server-tools)  cmd_server_tools "$@";;
  server-tools:manager-install) need_root; install_server_tools_manager;;
  workers:install|workers:update|waf:install|waf:update)
    tool_action="${1#*:}"; tool_group="${1%%:*}"; shift
    if [ "$tool_group" = waf ]; then tool_components=waf; else tool_components=database,web-logs,file-manager; fi
    cmd_server_tools server-tools "$tool_action" --components "$tool_components" "$@";;
  artisan)       cmd_artisan "$@";;
  uninstall)     cmd_uninstall;;
  ""|help|-h|--help)
    grep '^#' "$0" | sed -n '3,25p' | sed 's/^# \{0,1\}//';;
  *) die "Unknown command: $1 (try 'ispconfig-rest help')";;
esac
