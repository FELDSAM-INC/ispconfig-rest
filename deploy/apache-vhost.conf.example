# Complete configuration for the isolated ispconfig-rest-web service.
# Run its workers as the dedicated API account; pair with the private FPM pool.
ServerRoot /etc/apache2
DefaultRuntimeDir /run/ispconfig-rest-web
PidFile /run/ispconfig-rest-web/server.pid
Include /etc/apache2/mods-enabled/mpm_*.load
Include /etc/apache2/mods-available/authz_core.load
Include /etc/apache2/mods-available/authz_host.load
Include /etc/apache2/mods-available/dir.load
Include /etc/apache2/mods-available/mime.load
Include /etc/apache2/mods-available/ssl.load
Include /etc/apache2/mods-available/socache_shmcb.load
Include /etc/apache2/mods-available/proxy.load
Include /etc/apache2/mods-available/proxy_fcgi.load
Include /etc/apache2/mods-available/rewrite.load
User ispconfig-rest
Group ispconfig-rest
ServerName server.example.com
Listen 8090
TypesConfig /etc/mime.types
ErrorLog /var/log/ispconfig-rest/web-error.log
LogFormat "%h %l %u %t \"%r\" %>s %b" api
CustomLog /var/log/ispconfig-rest/web-access.log api
<Directory />
    AllowOverride None
    Require all denied
</Directory>
<VirtualHost _default_:8090>
    DocumentRoot "/opt/ispconfig-rest/public"
    LimitRequestBody 16777216
    SSLEngine On
    SSLProtocol All -SSLv3 -TLSv1 -TLSv1.1
    SSLCertificateFile "/usr/local/ispconfig/interface/ssl/ispserver.crt"
    SSLCertificateKeyFile "/usr/local/ispconfig/interface/ssl/ispserver.key"

    <Directory "/opt/ispconfig-rest/public">
        Options FollowSymLinks
        AllowOverride None
        Require all granted
        DirectoryIndex index.php
        RewriteEngine On
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^ index.php [END]
        <FilesMatch "(?i)\.php$">
            Require all denied
        </FilesMatch>
        <FilesMatch "^\.">
            Require all denied
        </FilesMatch>
    </Directory>
    <LocationMatch "^/index\.php$">
        Require all granted
        SetHandler "proxy:unix:/run/ispconfig-rest.sock|fcgi://localhost"
    </LocationMatch>
</VirtualHost>
