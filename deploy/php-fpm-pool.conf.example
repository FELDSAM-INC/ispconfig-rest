; ISPConfig REST API — dedicated php-fpm pool (what the installer generates).
; Place in the fpm pool dir: Debian /etc/php/<ver>/fpm/pool.d/, RHEL /etc/php-fpm.d/
; then reload the fpm service (e.g. systemctl reload php8.3-fpm).
;
; user/group = a dedicated API account, never shared with tenant workloads.
; Only the dedicated API web instance may connect to this socket.

[ispconfig-rest]
user = ispconfig-rest
group = ispconfig-rest
listen = /run/ispconfig-rest.sock
listen.owner = ispconfig-rest
listen.group = ispconfig-rest
listen.mode = 0600
security.limit_extensions = .php
php_admin_value[cgi.fix_pathinfo] = 0
pm = ondemand
pm.max_children = 10
pm.process_idle_timeout = 10s
pm.max_requests = 500
php_admin_value[expose_php] = off
php_admin_flag[display_errors] = off
