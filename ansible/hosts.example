# Copy to "hosts" and list your servers by their FQDN; that becomes the ISPConfig server name.
# ispconfig_address: the address the ISPConfig servers use for each other (default: the default IPv4 address).

[ispconfig_panel]
panel.example.com ispconfig_address=10.0.0.10

[ispconfig_web]
web1.example.com ispconfig_address=10.0.0.11
web2.example.com ispconfig_address=10.0.0.12

[ispconfig_db]
db1.example.com ispconfig_address=10.0.0.21

[ispconfig_dns]
ns1.example.com ispconfig_address=10.0.0.31

# Optional: BIND secondaries that follow the catalog zones of the DNS servers (dns-catalog/README.md).
[ispconfig_dns_primaries:children]
ispconfig_dns

[ispconfig_dns_secondaries]
# ns2.example.net
