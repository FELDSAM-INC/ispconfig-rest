{#- Values for files/autoinstall.php: replace keys of the autoinstaller's generated autoinstall.ini. -#}
{%- set values = {'ispconfig_port': ispconfig_interface_port | string} -%}
{%- for field, value in ispconfig_ssl_cert.items() -%}
{%-   set _ = values.update({'ssl_cert_' ~ field: value | string}) -%}
{%- endfor -%}
{%- if 'panel' in ispconfig_services -%}
{%-   set _ = values.update({'ispconfig_admin_password': ispconfig_admin_password}) -%}
{%- else -%}
{%-   set _ = values.update({
        'join_multiserver_setup': 'y',
        'mysql_master_hostname': hostvars[ispconfig_master].ispconfig_ip,
        'mysql_master_port': ispconfig_master_db_port | string,
        'mysql_master_root_user': ispconfig_master_db_admin_user,
        'mysql_master_root_password': ispconfig_master_db_admin_password,
        'mysql_master_database': 'dbispconfig',
        'install_ispconfig_web_interface': 'n'}) -%}
{%- endif -%}
{{ values | to_json }}
